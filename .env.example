# Reddit API credentials
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=market-predictor:v1.0 (by /u/yourusername)

# Optional Twitter/X scraping credentials
# TWITTER_BEARER_TOKEN=your_token_here

# AWS / DVC remote storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
DVC_REMOTE=s3://your-bucket/path

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=market_direction

# Application settings
SENTIMENT_LOG_LEVEL=INFO
VITE_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
